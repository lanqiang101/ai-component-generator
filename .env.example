# AI Component Generator 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ===== Pages Functions 代理配置 =====
# 本地开发环境使用的 Pages Functions 地址
# 可选值:
# - https://daily-0-0-1.ai-component-generator.pages.dev (测试环境,默认)
# - https://ai-component-generator.pages.dev (生产环境)
AI_PROXY_BASE_URL=https://daily-0-0-1.ai-component-generator.pages.dev

# ===== 火山方舟 API 配置 (仅用于 Pages Functions 部署) =====
# 注意: 这些变量不应在本地 .env 文件中配置,而应通过 Cloudflare Secrets 设置
# 使用命令: wrangler secret put API_KEY
# API_KEY=your_volcengine_api_key_here
# ARK_API_URL=https://ark.cn-beijing.volces.com/api/coding/v3/chat/completions

# ===== 其他配置 =====
# NODE_ENV=development